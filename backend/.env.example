# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Where the Next.js app runs. Used for CORS and for OAuth redirects back home.
FRONTEND_URL=http://localhost:3000
# Public URL of THIS service. Slack's redirect_uri must match it exactly.
BACKEND_URL=http://localhost:4000

# Secret used to sign the session JWT this API hands to the frontend.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Datastores
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5432/reachinbox
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=emails
# If Elasticsearch is unreachable the API degrades to a Postgres search instead
# of failing. Set to false to make ES a hard dependency.
ELASTICSEARCH_FALLBACK_TO_DB=true

# ---------------------------------------------------------------------------
# Queue / worker tuning  (all of these are read at boot, nothing is hardcoded)
# ---------------------------------------------------------------------------
EMAIL_QUEUE_NAME=email-send
# How many emails one worker process may have in flight at once.
WORKER_CONCURRENCY=5
# Run the worker inside the API process. Set false and run `npm run dev:worker`
# to prove the same code scales horizontally.
RUN_WORKER_IN_API=true
# Minimum wall-clock gap between two sends from the SAME sender, in ms.
MIN_GAP_MS_PER_SENDER=2000
# Hourly ceiling per sender. A campaign may request less, never more.
MAX_EMAILS_PER_HOUR_PER_SENDER=200
# Safety net across every sender of one account.
MAX_EMAILS_PER_HOUR_GLOBAL=1000
# Attempts before a send is marked FAILED.
JOB_ATTEMPTS=3
JOB_BACKOFF_MS=5000
# Completed/failed jobs kept in Redis for the Bull Board view.
KEEP_COMPLETED_JOBS=1000
KEEP_FAILED_JOBS=5000

# ---------------------------------------------------------------------------
# Google OAuth  (https://console.cloud.google.com/apis/credentials)
# Must be the SAME client id the frontend uses: this service verifies the
# signature and the `aud` claim of the ID token the browser forwards, so a
# mismatch is rejected. No client secret is required anywhere.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ---------------------------------------------------------------------------
# Slack OAuth  (https://api.slack.com/apps -> OAuth & Permissions)
# Bot scopes: incoming-webhook, chat:write
# Redirect URL: http://localhost:4000/api/slack/oauth/callback
# ---------------------------------------------------------------------------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SCOPES=incoming-webhook,chat:write
# Optional escape hatch for demos: if a user has not connected Slack, alerts go
# here instead. Leave empty to simply skip notifying.
SLACK_FALLBACK_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Ethereal SMTP
# `npm run seed:senders` provisions mailboxes automatically and prints them.
# Paste up to three here to reuse the same inboxes across restarts.
# ---------------------------------------------------------------------------
ETHEREAL_AUTO_PROVISION=true
ETHEREAL_SENDER_COUNT=3
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587

SENDER_1_EMAIL=
SENDER_1_USER=
SENDER_1_PASSWORD=

SENDER_2_EMAIL=
SENDER_2_USER=
SENDER_2_PASSWORD=

SENDER_3_EMAIL=
SENDER_3_USER=
SENDER_3_PASSWORD=
