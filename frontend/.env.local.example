# URL of the Express API
NEXT_PUBLIC_API_URL=http://localhost:4000

# Google OAuth client ID  (https://console.cloud.google.com/apis/credentials)
# Create an "OAuth client ID" of type "Web application" and add:
#   Authorised JavaScript origins: http://localhost:3000
# No client secret is needed: the browser receives a signed ID token from
# Google and the Express API verifies that token itself.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
